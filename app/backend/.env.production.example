# ==============================================================================
# Tortuguero Huellas - Configuración de Producción (AlwaysData)
# ==============================================================================
# Copie este archivo como .env en app/backend/ en el servidor AlwaysData
# y complete las credenciales asignadas en su panel de control.

CI_ENVIRONMENT = production

# Identidad y Origen Público (usado para enlaces de QR y notificaciones)
TORTUGUERO_HUELLAS_PUBLIC_ORIGIN = https://tortuguerohuellas.alwaysdata.net
TORTUGUERO_HUELLAS_DEMO_SEED = false
TORTUGUERO_HUELLAS_DEMO_ADMIN_EMAIL = administrador@tortuguerohuellas.org

# Base de Datos MariaDB / MySQL en AlwaysData
# El host suele ser mysql-[cuenta].alwaysdata.net o 127.0.0.1
database.default.hostname = mysql-tortuguerohuellas.alwaysdata.net
database.default.database = tortuguerohuellas_db
database.default.username = tortuguerohuellas
database.default.password = TU_CONTRASENA_AQUI
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.strictOn = true
